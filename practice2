def func(num, lst=[]):     #默认参数 lst=[] 只在函数定义的时候创建一次，不会每次调用新建空列表
 
                            #执行过程：
 
                            #1.  func(1)  → 往同一个列表追加1 → 返回 [1] 
​
                            #2.  func(2)  → 继续往这个列表追加2 → 返回 [1,2] 
 
                            #输出：[1]
                            #[1, 2]

    lst.append(num)
    return lst

print(func(1))
print(func(2))
